# ==============================================================================
# SMART TRAVEL ASSISTANT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI CONFIGURATION (Mặc định dùng OpenRouter trước)
# ------------------------------------------------------------------------------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_MODEL=anthropic/claude-3.5-sonnet

# ------------------------------------------------------------------------------
# 2. SLACK BOT CONFIGURATION
# ------------------------------------------------------------------------------
# Bot User OAuth Token (bắt đầu bằng xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing Secret lấy từ mục "Basic Information" của Slack App
SLACK_SIGNING_SECRET=your-slack-signing-secret-here

# Channel ID nhận cảnh báo lỗi kiểm toán (ví dụ: C0123456789)
# Cách lấy: Click chuột phải vào channel trên Slack -> View channel details -> Kéo xuống dưới cùng copy Channel ID
SLACK_ADMIN_CHANNEL_ID=C0123456789

# ------------------------------------------------------------------------------
# 3. GOOGLE SHEETS CONFIGURATION
# ------------------------------------------------------------------------------
# Đường dẫn tới file JSON Service Account đã tải từ Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json

# ID của file Google Sheet (Lấy từ URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Tên Sheet (tab) chứa dữ liệu
GOOGLE_SHEET_TAB_NAME=Lịch_Trình_Công_Tác

# ------------------------------------------------------------------------------
# 4. AWS / LOCALSTACK CONFIGURATION
# ------------------------------------------------------------------------------
# Bật true để chạy giả lập trên máy tính bằng LocalStack (không tốn tiền AWS)
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT=http://localhost:4566

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Email gửi thông báo nhắc lịch SES
SES_SENDER_EMAIL=admin@company.com

