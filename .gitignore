# 1. Environment & Sensitive Credentials (STRICTLY DO NOT COMMIT)
.env
.env.local
.env.*.local
*.pem
credentials/*.json
!credentials/README.md
service-account*.json
google-credentials.json

# 2. Local Emulation Data (LocalStack & DynamoDB)
localstack_data/
.localstack/
dynamodb_data/

# 3. Terraform IaC Secrets & Generated State
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
dist/
*.zip

# 4. Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. OS & IDE Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
icon_aws/

# 6. Documentation (Keep only diagrams and Idea.md in git, ignore all other docs)
docs/*
!docs/diagrams/
!docs/diagrams/**
!docs/Idea.md
!docs/idea.md

