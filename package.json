{
  "name": "smart-travel-assistant",
  "version": "1.0.0",
  "description": "Enterprise Corporate Travel Automation Platform on AWS Serverless and Generative AI",
  "main": "lambda/slack_handler.js",
  "scripts": {
    "test": "node tests/comprehensive_tester.js && node tests/e2e_simulation_test.js",
    "test:unit": "node tests/comprehensive_tester.js",
    "test:e2e": "node tests/e2e_simulation_test.js",
    "test:pr": "node scripts/test_ai_pr.js",
    "init:sheets": "node scripts/init_and_test.js",
    "sync:audit": "node scripts/sync_and_audit.js",
    "reminder": "node scripts/reminder_worker.js",
    "start:local": "node scripts/slack_server.js",
    "test:visual": "python tests/visual_diagram_check.py",
    "lint:syntax": "node --check lambda/common.js && node --check lambda/ai_ocr_service.js && node --check lambda/slack_handler.js && node --check lambda/reminder_cron.js"
